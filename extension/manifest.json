{
  "manifest_version": 3,
  "name": "BS Meter - Twitter Evidence Overlay",
  "version": "1.0.0",
  "description": "Displays live BS Index scores, falsehood flags, and spam detection powered by Context.dev next to Twitter/X users.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BS Meter Configuration"
  }
}
