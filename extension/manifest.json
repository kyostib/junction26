{
  "manifest_version": 3,
  "name": "BS Meter - Twitter Evidence Overlay",
  "version": "1.0.6",
  "description": "Displays live BS Index scores, falsehood flags, and spam detection powered by Context.dev next to Twitter/X users.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BS Meter Configuration"
  }
}
