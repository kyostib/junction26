# Database (PostgreSQL default, or sqlite+aiosqlite:///./bs_meter.db for local file)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bsmeter

# Context.dev API Key (powers Twitter profile scraping, link uncloaking, and web search)
CONTEXT_DEV_API_KEY=

# LLM Configuration (OpenAI, Gemini, or mock)
LLM_API_KEY=
LLM_PROVIDER=mock

# Analysis settings
MAX_CLAIMS_TO_VERIFY=5
