ENVIRONMENT=dev

# Docker Compose database credentials. Use a long random hex password on the VPS.
POSTGRES_USER=bsmeter
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=bsmeter

# Context.dev API Key (powers Twitter profile scraping, link uncloaking, and web search)
CONTEXT_DEV_API_KEY=

# LLM configuration. Real Twitter profiles require Gemini (or another future
# model-backed provider); `mock` is restricted to the explicit mock platform.
LLM_API_KEY=
LLM_PROVIDER=mock
LLM_MODEL=gemini-4-hydrogen

# Analysis settings
MAX_CLAIMS_TO_VERIFY=5
